# Copy to .env to override defaults. Everything is optional.

# Postgres connection string (e.g. Neon). Without it, an embedded PGlite
# database is created in apps/api/.data — no setup needed.
DATABASE_URL=

PORT=8787

# open-meteo (default) or synthetic (deterministic weather, no network)
WEATHER_PROVIDER=open-meteo

# Re-seed the demo farm every day just after the irrigation window closes.
DEMO_NIGHTLY_RESET=true
DEMO_RESET_AT=05:30
